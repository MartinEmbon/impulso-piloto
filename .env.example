# Node no carga .env automáticamente: usá node --env-file=.env server.mjs
PORT=3000
DATA_DIR=./data
INSTITUTION_NAME=Institución piloto
INSTITUTION_CODE=replace-with-a-long-private-student-code
ADMIN_CODE=replace-with-a-different-long-private-admin-code
# Configuración opcional: sin ambas variables el tutor queda deshabilitado.
OPENAI_API_KEY=
OPENAI_MODEL=
